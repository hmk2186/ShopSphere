# ============================================================
# ShopSphere Backend Environment Configuration Template
# ============================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas OR Local Community Server)
# Both MONGODB_URI and MONGO_URI variable names are supported.
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopsphere?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/shopsphere
MONGODB_URI=mongodb://localhost:27017/shopsphere

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRE=30d

# Frontend Client URL (For CORS Whitelist)
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway Credentials (Test Mode)
# Leave placeholder or empty to trigger safe simulated test checkout in dev mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Cloudinary Storage Credentials (Optional - auto falls back to local uploads folder)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
